# ─── API ─────────────────────────────────────────────────────────────────────
# Direct production connection (recommended for deployed frontend).
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Local development can leave NEXT_PUBLIC_API_URL blank and proxy through Next:
# NEXT_PUBLIC_API_URL=
BACKEND_ORIGIN=http://localhost:4000

# ─── WebSocket ───────────────────────────────────────────────────────────────
# Socket.io connects directly to the backend — NOT through the Next.js proxy.
# WebSocket upgrades are not forwarded by the built-in Next.js rewrite proxy.
NEXT_PUBLIC_BACKEND_WS_URL=http://localhost:4000

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
