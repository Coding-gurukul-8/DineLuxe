# Frontend public runtime
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Frontend server-side proxy target.
# Use this only when the deployed frontend should proxy /api/v1/* through Next.
# Leave unset in production when NEXT_PUBLIC_API_URL points directly at the backend.
BACKEND_ORIGIN=https://api.example.com

# Backend runtime
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://app.example.com
# Optional comma-separated list for previews/custom domains.
FRONTEND_URLS=https://app.example.com,https://www.example.com

DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:<password>@<host>:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

REDIS_URL=redis://default:<password>@<host>:<port>
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=DineLuxe <noreply@example.com>

BCRYPT_SALT_ROUNDS=12
OTP_EXPIRY_SECONDS=600
GEO_FENCE_RADIUS_METERS=100
