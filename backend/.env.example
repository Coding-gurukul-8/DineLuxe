PORT=4000
NODE_ENV=development

FRONTEND_URL=http://localhost:3000
# Optional comma-separated list, useful for production + preview domains.
FRONTEND_URLS=http://localhost:3000,http://localhost:3001,http://localhost:3002

DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:<password>@<host>:5432/postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

REDIS_URL=redis://default:<password>@<host>:<port>
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=DineLuxe <noreply@example.com>

BCRYPT_SALT_ROUNDS=12
OTP_EXPIRY_SECONDS=600
GEO_FENCE_RADIUS_METERS=100
