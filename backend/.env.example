# DineLuxe backend environment template
# Copy this file to backend/.env and replace the placeholders with real values.

PORT=4000
NODE_ENV=development

FRONTEND_URL=http://localhost:3000 # Primary frontend origin
FRONTEND_URLS=http://localhost:3000,http://localhost:3001,http://localhost:3002 # Comma-separated allowed origins

DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres?pgbouncer=true # Prisma pooled connection string
DIRECT_URL=postgresql://postgres:<password>@<host>:5432/postgres # Direct Postgres connection string for migrations

SUPABASE_URL=https://your-project.supabase.co # Supabase project URL
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key # Supabase service-role key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret # Supabase JWT signing secret

REDIS_URL=redis://default:<password>@<host>:<port> # Redis connection string
RESEND_API_KEY=your-resend-api-key # Resend API key for emails
EMAIL_FROM=DineLuxe <noreply@example.com> # Transactional sender address

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key # Public push subscription key
VAPID_PRIVATE_KEY=your-vapid-private-key # Private push signing key
VAPID_CONTACT_EMAIL=push@example.com # Contact email shown in push metadata

BCRYPT_SALT_ROUNDS=12 # Password hashing cost factor
OTP_EXPIRY_SECONDS=600 # OTP lifetime in seconds
GEO_FENCE_RADIUS_METERS=100 # Geofence radius for arrival/check-in flows

LOYALTY_POINTS_PER_RUPEE=0.1 # Loyalty points earned per rupee spent
LOYALTY_MIN_REDEEM_POINTS=50 # Minimum balance required to redeem points
LOYALTY_RUPEES_PER_POINT=0.1 # Rupee value of one loyalty point

QUEUE_NO_SHOW_GRACE_MINUTES=15 # Minutes before an arrived queue entry is marked no-show
KITCHEN_OVERDUE_THRESHOLD_MINUTES=30 # Minutes before kitchen orders are flagged overdue

DEFAULT_UPI_ID=restaurant@upi # Fallback UPI handle for payment flows

# Optional payment gateway settings
# RAZORPAY_KEY_ID=rzp_live_xxxx
# RAZORPAY_KEY_SECRET=xxxx
# RAZORPAY_WEBHOOK_SECRET=xxxx
# STRIPE_SECRET_KEY=sk_live_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Optional feature flags
# ENABLE_PUSH_NOTIFICATIONS=true
# ENABLE_LOYALTY=true
# ENABLE_REVIEW_NOTIFICATIONS=true
# ENABLE_SUPPORT_NOTIFICATIONS=true
