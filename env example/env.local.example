# ─────────────────────────────────────────────────────────────────────────────
# DineLuxe — Frontend environment variables
# Copy this file to .env.local and fill in every value before running the app.
# Variables prefixed NEXT_PUBLIC_ are embedded in the browser bundle — never
# put secrets here. Server-only secrets belong in the backend .env instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
# Full URL of the backend API, including the /api/v1 prefix.
# The api-client.ts normalises this, so trailing slashes are safe to include.
# Leave unset (or omit entirely) on same-host deploys — the client falls back
# to the relative path "/api/v1" automatically.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── Supabase (public / anon) ──────────────────────────────────────────────────
# These are safe to expose to the browser — they are the public-facing keys.
# Found in: Supabase dashboard → Project Settings → API → Project URL / anon key
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
