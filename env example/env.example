# ─────────────────────────────────────────────────────────────────────────────
# DineLuxe — Backend environment variables
# Copy this file to .env and fill in every value before starting the server.
# The Zod schema in src/config/env.ts validates all variables at boot; the
# server will refuse to start if any required value is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=4000                     # Port the Express server listens on

# ── Database (Supabase / Postgres via Prisma) ─────────────────────────────────
# Pooled connection — used by Prisma at runtime (pgBouncer in transaction mode).
DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres?pgbouncer=true

# Direct connection — used by Prisma Migrate and introspection (bypasses pgBouncer).
DIRECT_URL=postgresql://postgres:<password>@<host>:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co

# Service-role key — has full DB access; never expose to clients.
# Found in: Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# JWT secret — must match the value in Supabase dashboard → Project Settings →
# API → JWT Settings → JWT Secret. Used to sign and verify all access/refresh
# tokens. SUPABASE_JWT_SECRET is the single source of truth; JWT_SECRET (if it
# existed) has been removed to avoid confusion.
SUPABASE_JWT_SECRET=<jwt-secret-from-supabase-dashboard>

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for session caching, rate limiting, and BullMQ job queues.
REDIS_URL=redis://localhost:6379
# For a managed Redis (e.g. Upstash): redis://default:<password>@<host>:<port>

# ── CORS / Frontend ───────────────────────────────────────────────────────────
# Primary frontend origin — used as the CORS fallback if FRONTEND_URLS is unset.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed origins — extend for preview / staging URLs.
# Example: http://localhost:3000,https://dineluxe.vercel.app
FRONTEND_URLS=http://localhost:3000

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_<your-resend-api-key>
EMAIL_FROM=DineLuxe <noreply@yourdomain.com>

# ── Auth / Security ───────────────────────────────────────────────────────────
# bcrypt work factor — must be between 10 and 14 (inclusive).
BCRYPT_SALT_ROUNDS=12

# OTP validity window in seconds (minimum 60). Default: 600 (10 minutes).
OTP_EXPIRY_SECONDS=600

# Geo-fence radius for staff check-in validation, in metres (must be > 0).
GEO_FENCE_RADIUS_METERS=100

# ── Payments (Razorpay) — uncomment when payment module is activated ──────────
# RAZORPAY_KEY_ID=rzp_test_<your-key-id>
# RAZORPAY_KEY_SECRET=<your-key-secret>
# RAZORPAY_WEBHOOK_SECRET=<webhook-signing-secret>
